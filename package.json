{
  "name": "pocketool",
  "description": "A 100% static, local-first suite of developer tools. Works offline, no tracking, no backend.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "FrancisDeea",
  "license": "MIT",
  "homepage": "https://github.com/FrancisDeea/pocketool",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancisDeea/pocketool.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/react": "^4.2.1",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "@nanostores/persistent": "^1.0.0",
    "@nanostores/react": "^1.0.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^6.1.5",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.1",
    "dexie": "^4.0.1",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.488.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "mermaid": "^11.6.0",
    "nanostores": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "dompurify@<=3.3.3": ">=3.4.0"
    }
  }
}
