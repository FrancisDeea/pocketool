---
import Layout from "@/layouts/Layout.astro";
import Shell from "@/components/layout/Shell";
import { getAllTools } from "@/tools/registry";
import { Zap, Lock, WifiOff, ArrowRight } from "lucide-react";

const tools = getAllTools();

// Duplicate the list for seamless infinite loop
const row1 = [...tools, ...tools];
const row2 = [...tools, ...tools].reverse();
---

<Layout title="Home" lang="es">
  <Shell tools={tools} locale="es" client:load>
    <!-- Hero -->
    <div class="relative overflow-hidden">
      <!-- Background gradient glow -->
      <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
        <div class="h-[500px] w-[700px] rounded-full bg-accent/5 blur-[120px]"></div>
      </div>

      <div class="max-w-3xl mx-auto text-center py-14 md:py-24 px-4">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 text-xs font-semibold text-accent bg-accent/10 rounded-full border border-accent/20 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          100% Local-First · Sin cuenta · Sin tracking
        </div>

        <!-- Headline -->
        <h1 class="text-5xl md:text-7xl font-extrabold text-text-primary mb-6 leading-[1.08] tracking-tight">
          Herramientas
          <br />
          <span
            class="bg-gradient-to-r from-accent via-accent/80 to-accent/60 bg-clip-text text-transparent"
          >
            para desarrolladores
          </span>
        </h1>

        <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto mb-12 leading-relaxed">
          Una suite de herramientas rápidas y privadas. Sin servidores, sin
          cuentas. Todo el procesamiento ocurre directamente en tu navegador.
        </p>

        <!-- Features row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left max-w-3xl mx-auto mb-16">
          <div class="group flex flex-col gap-3 p-5 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-all duration-300 hover:shadow-lg hover:shadow-accent/5">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent/20 transition-colors">
              <Lock size={18} />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-1">Privacidad Absoluta</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                Cero uploads a servidores externos. Tus archivos y datos nunca salen del navegador.
              </p>
            </div>
          </div>
          <div class="group flex flex-col gap-3 p-5 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-all duration-300 hover:shadow-lg hover:shadow-accent/5">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent/20 transition-colors">
              <WifiOff size={18} />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-1">Offline Ready (PWA)</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                Instálalo una vez y úsalo siempre, incluso sin conexión. Los datos persisten en IndexedDB.
              </p>
            </div>
          </div>
          <div class="group flex flex-col gap-3 p-5 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-all duration-300 hover:shadow-lg hover:shadow-accent/5">
            <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent/20 transition-colors">
              <Zap size={18} />
            </div>
            <div>
              <h3 class="text-sm font-semibold text-text-primary mb-1">Rendimiento Extremo</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                Construido con Astro y Web Workers. Cero JS innecesario. Respuesta instantánea.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tools Carousel -->
    <div class="pb-20 overflow-hidden">
      <div class="mb-6 text-center">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-text-tertiary">
          Herramientas disponibles
        </h2>
      </div>

      <!-- Row 1 — scrolls left -->
      <div class="carousel-mask relative mb-4">
        <div class="carousel-track carousel-left flex gap-4 w-max">
          {row1.map((tool) => (
            <a
              href={`/tool/${tool.id}`}
              data-astro-prefetch
              class="carousel-card group flex-shrink-0 flex flex-col w-64 p-5 rounded-2xl bg-surface border border-border hover:border-accent/40 transition-all duration-300 hover:shadow-xl hover:shadow-accent/10 hover:-translate-y-1"
            >
              <div class="flex items-start justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent/20 transition-colors">
                  <ArrowRight size={18} />
                </div>
                <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-surface-hover border border-border text-text-tertiary">
                  {tool.category}
                </span>
              </div>
              <h3 class="text-sm font-bold text-text-primary mb-1.5">{tool.title}</h3>
              <p class="text-xs text-text-secondary leading-relaxed flex-1 mb-3 line-clamp-2">
                {tool.description}
              </p>
              <div class="flex flex-wrap gap-1">
                {tool.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 text-[9px] font-medium text-text-tertiary bg-surface-hover rounded-full border border-border">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Row 2 — scrolls right -->
      <div class="carousel-mask relative">
        <div class="carousel-track carousel-right flex gap-4 w-max">
          {row2.map((tool) => (
            <a
              href={`/tool/${tool.id}`}
              data-astro-prefetch
              class="carousel-card group flex-shrink-0 flex flex-col w-64 p-5 rounded-2xl bg-surface border border-border hover:border-accent/40 transition-all duration-300 hover:shadow-xl hover:shadow-accent/10 hover:-translate-y-1"
            >
              <div class="flex items-start justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent group-hover:bg-accent/20 transition-colors">
                  <ArrowRight size={18} />
                </div>
                <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-surface-hover border border-border text-text-tertiary">
                  {tool.category}
                </span>
              </div>
              <h3 class="text-sm font-bold text-text-primary mb-1.5">{tool.title}</h3>
              <p class="text-xs text-text-secondary leading-relaxed flex-1 mb-3 line-clamp-2">
                {tool.description}
              </p>
              <div class="flex flex-wrap gap-1">
                {tool.tags.slice(0, 2).map((tag) => (
                  <span class="px-2 py-0.5 text-[9px] font-medium text-text-tertiary bg-surface-hover rounded-full border border-border">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </Shell>
</Layout>

<style>
  .carousel-mask {
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .carousel-track {
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .carousel-left {
    animation: scroll-left 40s linear infinite;
  }

  .carousel-right {
    animation: scroll-right 40s linear infinite;
  }

  .carousel-mask:hover .carousel-track {
    animation-play-state: paused;
  }

  /* Also pause when any card inside is hovered */
  .carousel-card:hover ~ .carousel-card {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scroll-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .carousel-left,
    .carousel-right {
      animation: none;
    }
  }
</style>
