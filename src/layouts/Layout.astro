---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Herramientas esenciales para desarrolladores. Rápidas, privadas y sin servidor.",
  lang = "es",
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Pocketool</title>
    <meta name="description" content={description} />

    <!-- Fonts: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- SPA navigation -->
    <ClientRouter />

    <!-- Theme initialization (avoid FOUC) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("app:theme");
          if (stored) {
            const theme = JSON.parse(stored);
            if (["light", "light-hc", "dark", "dark-hc"].includes(theme)) {
              document.documentElement.setAttribute("data-theme", theme);
            }
          } else {
            const prefersDark = window.matchMedia(
              "(prefers-color-scheme: dark)",
            ).matches;
            const prefersHc = window.matchMedia(
              "(prefers-contrast: more)",
            ).matches;
            let theme = "dark";
            if (prefersDark && prefersHc) theme = "dark-hc";
            else if (!prefersDark && prefersHc) theme = "light-hc";
            else if (!prefersDark) theme = "light";
            document.documentElement.setAttribute("data-theme", theme);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-text-primary">
    <slot />
  </body>
</html>
